# ============================================================
# EnterprisePOS — Environment Variables
# Copy this file: cp .env.example .env  then fill in values
# ============================================================

# ── SUPABASE DATABASE ──────────────────────────────────────
#
# You need TWO connection strings from Supabase:
# Dashboard → Settings → Database → Connection string
#
# 1. DATABASE_URL  → "Transaction pooler"  (use for the app at runtime)
#    Port: 6543, has ?pgbouncer=true
#
# 2. DIRECT_URL    → "Direct connection"   (used by Prisma for migrations & seeding)
#    Port: 5432, no ?pgbouncer param
#
# Both URLs are on the same page. Copy each one and replace [YOUR-PASSWORD].
#
# Example (replace xxxx and YOUR-PASSWORD with your actual values):
# DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

DATABASE_URL="postgresql://postgres:password@localhost:5432/enterprise_pos"
DIRECT_URL="postgresql://postgres:password@localhost:5432/enterprise_pos"

# ── AUTH ───────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32-output"
AUTH_URL="http://localhost:3000"

# ── WHATSAPP (optional) ────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
